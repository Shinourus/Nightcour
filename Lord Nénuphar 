/* ========================================
   NIGHTCOUR — A : FOND
   ======================================== */

html,
body {
    background-color: #080304 !important;

    background-image:
        radial-gradient(
            circle at 50% 0%,
            rgba(100, 0, 15, 0.35),
            transparent 55%
        ),
        linear-gradient(
            180deg,
            #18070a 0%,
            #0d0305 45%,
            #050203 100%
        ) !important;

    background-attachment: fixed !important;
    color: #d8caca;
}